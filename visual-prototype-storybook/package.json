{
    "name": "@crystalservice/csi_ui",
    "version": "1.31.2",
    "repository": "git://github.com/crystalservice/CSI_UI.git",
    "author": "CSI",
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "files": [
        "dist"
    ],
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        }
    },
    "engines": {
        "node": ">=14.17.5",
        "npm": ">=8.5.0"
    },
    "lint-staged": {
        "src/**/*.{ts,tsx,js,jsx}": []
    },
    "scripts": {
        "login": "bash ./npm-login.sh",
        "format": "prettier --write src/**/*.ts{,x}",
        "eslint": "npx eslint --max-warnings=0 src/**",
        "lint": "tsc --noEmit && eslint src/**/*.ts{,x}",
        "storybook": "start-storybook -p 6006 --disable-telemetry",
        "storybook:build": " build-storybook --output-dir docs",
        "storybook:export": "build-storybook",
        "chromatic": "npx chromatic --project-token=$CHROMATIC_TOKEN",
        "build": "rimraf dist && rollup -c && rimraf types",
        "prepublishOnly": "npm run build",
        "generate": "node ./scripts/generation-component/create-component",
        "husky-install": "husky install",
        "pre-commit": "lint-staged",
        "test": "npm run test:unit && cypress run --component",
        "test:unit": "jest --silent --maxWorkers=12",
        "test:ui": "cypress open --component"
    },
    "eslintConfig": {
        "overrides": [
            {
                "files": [
                    "**/*.stories.*"
                ],
                "rules": {
                    "import/no-anonymous-default-export": "off"
                }
            }
        ]
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "peerDependencies": {
        "react": ">=16.8.0",
        "react-dom": ">=16.8.0"
    },
    "dependencies": {
        "@material-ui/core": "^4.12.3",
        "@material-ui/icons": "^4.11.2",
        "classnames": "^2.3.1",
        "date-fns": "^2.28.0",
        "lodash": "^4.17.21",
        "react-imask": "^6.4.2",
        "react-window": "^1.8.6",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@babel/core": "^7.18.2",
        "@babel/plugin-transform-runtime": "^7.18.2",
        "@babel/preset-env": "^7.18.2",
        "@babel/preset-react": "^7.17.12",
        "@babel/preset-typescript": "^7.17.12",
        "@rollup/plugin-babel": "^5.3.1",
        "@rollup/plugin-commonjs": "^20.0.0",
        "@rollup/plugin-node-resolve": "^13.0.6",
        "@rollup/plugin-typescript": "^8.3.0",
        "@storybook/addon-actions": "^6.3.8",
        "@storybook/addon-controls": "^6.3.8",
        "@storybook/addon-essentials": "^6.3.8",
        "@storybook/addon-links": "^6.3.8",
        "@storybook/node-logger": "^6.3.8",
        "@storybook/react": "^6.3.8",
        "@types/faker": "^5.5.9",
        "@types/jest": "^29.1.1",
        "@types/lodash": "^4.14.178",
        "@types/node": "^16.18.3",
        "@types/react": "^16.14.26",
        "@types/react-dom": "^16.9.16",
        "@types/react-window": "^1.8.5",
        "@types/styled-components": "^5.1.15",
        "@types/uuid": "^8.3.4",
        "@typescript-eslint/eslint-plugin": "^5.6.0",
        "@typescript-eslint/parser": "^5.6.0",
        "@vitejs/plugin-react": "^2.1.0",
        "chromatic": "^6.0.0-canary.1",
        "cypress": "^12.9.0",
        "eslint": "^8.4.1",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "eslint-plugin-react": "^7.27.1",
        "faker": "^5.5.3",
        "husky": "^7.0.2",
        "i18next": "^21.5.2",
        "jest": "^29.1.2",
        "jest-environment-jsdom": "^29.1.2",
        "jest-extended": "^3.1.0",
        "lint-staged": "^11.1.2",
        "normalize.css": "^8.0.1",
        "postcss": "^8.4.4",
        "prettier": "^2.4.1",
        "react": "^16.14.0",
        "react-dom": "^16.14.0",
        "rimraf": "^3.0.2",
        "rollup": "^2.60.1",
        "rollup-plugin-dts": "^4.0.1",
        "rollup-plugin-peer-deps-external": "^2.2.4",
        "rollup-plugin-postcss": "^4.0.2",
        "rollup-plugin-terser": "^7.0.2",
        "rollup-plugin-typescript2": "^0.30.0",
        "storybook-addon-designs": "^6.1.0",
        "storybook-addon-themes": "^6.1.0",
        "styled-components": "^5.3.3",
        "tslib": "^2.3.1",
        "typescript": "4.5.4",
        "vite": "^3.1.6"
    },
    "overrides": {
        "es5-ext@>0.10.53": "0.10.53",
        "node-ipc@>9.2.1 <10": "9.2.1",
        "node-ipc@>10.1.0 <10.1.3": "10.1.0",
        "event-source-polyfill@>1.0.25 <1.0.29": "1.0.25",
        "debug@>4.4.1 <5": "4.4.1",
        "strip-ansi@>7.1.0 <7.1.2": "7.1.0",
        "ansi-regex@>6.2.0 <6.2.2": "6.2.0",
        "error-ex@>1.3.2 <2": "1.3.2"
    }
}
