{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "profiles", "domains"],
  "properties": {
    "schemaVersion": {"$ref": "schema-version.schema.json"},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["keywords"],
        "properties": {"keywords": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "owner", "policy", "requiredBeforePhase", "recommendedPath", "profileHint"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "owner": {"enum": ["PRODUCT_MANAGER", "SYSTEM_ANALYST", "ARCHITECT", "PRODUCT_COMPILER"]},
          "policy": {"enum": ["REQUIRED", "WHEN_RELEVANT", "DEFERRED", "INTERNAL", "PROTOTYPE_ONLY", "PROCESS_DECISION"]},
          "requiredBeforePhase": {"type": ["string", "null"], "enum": ["PRODUCT_DEFINITION", null]},
          "recommendedPath": {"type": "string", "minLength": 1},
          "profileHint": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
