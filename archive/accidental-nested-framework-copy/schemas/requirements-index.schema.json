{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "requirements", "needsInput", "errors", "qualityWarnings", "diagnostics"],
  "properties": {
    "schemaVersion": {"$ref": "schema-version.schema.json"},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "file", "line", "domainId", "domainIds", "status", "evidenceRefs", "horizon", "format"],
        "properties": {
          "id": {"type": "string", "pattern": "^((VISION|SCOPE|SCN|RULE|QUAL)-[0-9]{3}|REQ-[A-Z][A-Z0-9]*-[0-9]{3})$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "file": {"type": "string", "pattern": "^requirements/.+\\.md$"},
          "line": {"type": "integer", "minimum": 1},
          "domainId": {"type": "string", "minLength": 1},
          "domainIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "minLength": 1},
          "evidenceRefs": {"type": "array", "items": {"type": "string"}},
          "horizon": {"type": "string", "minLength": 1},
          "format": {"enum": ["SCENARIO_V5", "LEGACY"]}
        }
      }
    },
    "needsInput": {"type": "array"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "qualityWarnings": {"type": "array", "items": {"type": "string"}},
    "diagnostics": {"type": "array"}
  }
}
