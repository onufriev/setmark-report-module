{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "questions"],
  "properties": {
    "schemaVersion": {"$ref": "schema-version.schema.json"},
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "domainId", "domainIds", "title", "file", "line", "owner", "blocking", "neededFor", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q-[A-Z0-9-]+$"},
          "domainId": {"type": "string", "minLength": 1},
          "domainIds": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "title": {"type": "string", "minLength": 1},
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 1},
          "owner": {"enum": ["PRODUCT_MANAGER", "SYSTEM_ANALYST", "ARCHITECT", "DEVELOPMENT_TEAM"]},
          "blocking": {"type": "boolean"},
          "neededFor": {"type": "string", "minLength": 1},
          "status": {"enum": ["OPEN", "ANSWERED_NOT_APPLIED"]},
          "answerEvidenceRef": {"type": ["string", "null"]},
          "answeredAt": {"type": ["string", "null"]}
        }
      }
    }
  }
}
