{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.4"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "artifactPath",
          "artifactType",
          "verifiedAt",
          "checks",
          "result",
          "sha256",
          "recordedBy"
        ],
        "properties": {
          "id": {
            "pattern": "^ART-EV-[0-9]{3,}$"
          },
          "phase": {
            "type": "string"
          },
          "artifactPath": {
            "type": "string",
            "minLength": 1
          },
          "artifactType": {
            "type": "string",
            "minLength": 1
          },
          "verifiedAt": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "array",
            "minItems": 1
          },
          "result": {
            "enum": [
              "PASSED",
              "FAILED"
            ]
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$"
          },
          "verificationCommand": {
            "type": "string"
          },
          "runbookPath": {
            "type": [
              "string",
              "null"
            ]
          },
          "dataSourceRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "recordedBy": {
            "const": "register_artifact_evidence.py"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
