{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "entryPoint",
    "startCommand",
    "url",
    "dataMode",
    "dataLocation",
    "runbookPath",
    "verificationCommand",
    "sourceType",
    "sourceReference",
    "interactionLevel",
    "requiredUserPath",
    "smokeTest",
    "materializedAt",
    "uiSourceMode",
    "applicationMode"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "schema-version.schema.json"
    },
    "status": {
      "enum": [
        "NOT_STARTED",
        "READY"
      ]
    },
    "interactionLevel": {
      "enum": [
        null,
        "CLICKABLE"
      ]
    },
    "sourceType": {
      "enum": [
        null,
        "DIRECTORY",
        "HTML_FILE"
      ]
    },
    "sourceMode": {
      "description": "Deprecated compatibility alias for applicationMode",
      "enum": [
        null,
        "EXISTING_CLICKABLE_APP",
        "GENERATED_PROTOTYPE"
      ]
    },
    "requiredUserPath": {
      "type": "array"
    },
    "smokeTest": {
      "type": "object"
    },
    "uiSourceMode": {
      "enum": [
        null,
        "FIGMA",
        "COMPONENT_LIBRARY",
        "STORYBOOK"
      ]
    },
    "applicationMode": {
      "enum": [
        null,
        "EXISTING_CLICKABLE_APP",
        "GENERATED_PROTOTYPE"
      ]
    }
  }
}
