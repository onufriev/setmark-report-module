{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "strategy",
    "sourceMode",
    "applicationMode",
    "status",
    "candidates",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.4"
    },
    "strategy": {
      "enum": [
        "UNKNOWN",
        "FIGMA",
        "COMPONENT_LIBRARY",
        "STORYBOOK"
      ]
    },
    "usageMode": {
      "enum": [
        "UNDECIDED",
        "SELECTED_UI_SOURCE",
        "ADOPTED_PROTOTYPE",
        "GENERATED_PROTOTYPE"
      ]
    },
    "sourceMode": {
      "enum": [
        "UNDECIDED",
        "FIGMA",
        "COMPONENT_LIBRARY",
        "STORYBOOK"
      ]
    },
    "status": {
      "enum": [
        "UNKNOWN",
        "SELECTED",
        "INSPECTED"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "selectedCandidateId": {
      "type": [
        "string",
        "null"
      ]
    },
    "inspectedComponents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "neutralFallbackApproved": {
      "type": "boolean"
    },
    "temporary": {
      "type": "boolean"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "candidates": {
      "type": "array"
    },
    "applicationMode": {
      "enum": [
        "UNDECIDED",
        "EXISTING_CLICKABLE_APP",
        "GENERATED_PROTOTYPE"
      ]
    }
  }
}
