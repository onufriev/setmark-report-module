{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "sourceType",
    "evidenceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "4.3"
    },
    "status": {
      "enum": [
        "Требуется решение",
        "Подтверждено Product Manager",
        "Временно принято Product Manager"
      ]
    },
    "sourceType": {
      "enum": [
        "UNKNOWN",
        "REAL_OBJECT",
        "MANUAL_INPUT",
        "DATABASE_SCRIPT",
        "CSV",
        "EMULATOR",
        "POSTMAN_COLLECTION",
        "API",
        "OTHER"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "dataClassification": {
      "enum": [
        null,
        "REAL",
        "ANONYMIZED",
        "SYNTHETIC",
        "DEMO",
        "MIXED"
      ]
    },
    "setupMethod": {
      "type": [
        "string",
        "null"
      ]
    },
    "verificationMethod": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
