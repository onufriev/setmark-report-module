{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "currentBaselineId",
    "baselines"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "schema-version.schema.json"
    },
    "status": {
      "enum": [
        "NOT_COMMITTED",
        "COMMITTED",
        "STALE"
      ]
    },
    "currentBaselineId": {
      "type": [
        "string",
        "null"
      ]
    },
    "baselines": {
      "type": "array"
    },
    "staleAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "staleReason": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
