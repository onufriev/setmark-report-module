{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "profiles", "domains"],
  "properties": {
    "schemaVersion": {"const": "4.4"},
    "profiles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["keywords"],
        "properties": {
          "keywords": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "file", "requiredBeforePhase", "profileHint"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "file": {"type": "string", "pattern": "^requirements/.+\\.md$"},
          "requiredBeforePhase": {"enum": ["VISUAL_PROTOTYPE", "WORKING_PROTOTYPE"]},
          "profileHint": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
