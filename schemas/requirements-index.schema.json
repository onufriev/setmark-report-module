{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "requirements",
    "needsInput",
    "errors",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "schema-version.schema.json"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "file",
          "line",
          "domainId",
          "status",
          "evidenceRefs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^REQ-[A-Z][A-Z0-9]*-[0-9]{3}$"
          }
        }
      }
    },
    "needsInput": {
      "type": "array"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array"
    }
  }
}
