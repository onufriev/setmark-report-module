{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "reviews"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "schema-version.schema.json"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewId",
          "phase",
          "revision",
          "status",
          "markdownReport",
          "pdfReport",
          "nextPhase"
        ],
        "properties": {
          "status": {
            "enum": [
              "READY_FOR_REVIEW",
              "APPROVED",
              "REJECTED",
              "SUPERSEDED",
              "STALE_REVIEW"
            ]
          }
        }
      }
    }
  }
}
