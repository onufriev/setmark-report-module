{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "conflicts"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "schema-version.schema.json"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "severity",
          "status",
          "statements"
        ],
        "properties": {
          "id": {
            "pattern": "^CONFLICT-[0-9]{3,}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "MAJOR",
              "MINOR"
            ]
          },
          "status": {
            "enum": [
              "OPEN",
              "RESOLVED",
              "ACCEPTED"
            ]
          },
          "statements": {
            "type": "array",
            "minItems": 2
          },
          "resolutionRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
