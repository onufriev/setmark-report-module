{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "productName",
    "productVersion",
    "currentPhase",
    "status",
    "sourceSetup",
    "phaseReview",
    "artifactStatus"
  ],
  "properties": {
    "schemaVersion": {
      "$ref": "schema-version.schema.json"
    },
    "productName": {
      "const": "Product Compiler"
    },
    "productVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+(?:\\.\\d+)?$"
    }
  }
}
